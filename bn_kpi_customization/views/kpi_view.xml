<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_kpi_list" model="ir.ui.view">
        <field name="name">kpi.kpi.list</field>
        <field name="model">kpi.kpi</field>
        <field name="arch" type="xml">
        <list>
            <field name="name" />
            <field name="code" />
            <field name="team_id" />
            <field name="from_date" required="1"/>
            <field name="to_date" required="1"/>
        </list>
        </field>
    </record>

    <record id="view_kpi_form" model="ir.ui.view">
        <field name="name">kpi.kpi.form</field>
        <field name="model">kpi.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- <label for="name" string="Name"/> -->
                    <div class="oe_title">
                        <h1 class="oe_title">
                            <field name="name" placeholder="KPI Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <label for="from_date" string="Period"/>
                            <div class="o_row">
                                <field name="from_date" 
                                    widget="daterange" 
                                    nolabel="1" 
                                    class="oe_inline" 
                                    options="{'related_to_date': 'to_date'}"/>
                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow" title="Arrow"/>
                                <field name="to_date" 
                                    widget="daterange" 
                                    nolabel="1" 
                                    class="oe_inline" 
                                    options="{'related_from_date': 'from_date'}"/>
                            </div>
                        </group>
                        <group>
                            <field name="team_id" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Targets">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="parameter_id"/>
                                    <field name="allocation"/>
                                    <field name="value"/>
                                    <field name="score" />
                                </list>
                            </field>
                        </page>
                        <page string="Employee Targets">
                            <field name="employee_target_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="kpi_line_id" force_save="1"  optional="hide"/>
                                    <field name="employee_id" readonly="1" force_save="1"/>
                                    <field name="parameter_id" readonly="1" force_save="1"/>
                                    <field name="parameter_type" optional="hide" />
                                    <field name="value" force_save="1"/>
                                    <!-- <field name="achieved" force_save="1" readonly="parameter_type == 'auto'"/>
                                    <field name="current_achievement" readonly="1" force_save="1" widget="progressbar"/>
                                    <field name="current_state" force_save="1" readonly="1" widget="badge" decoration-danger="current_state == 'danger'"
                                    decoration-warning="current_state == 'warning'"
                                    decoration-success="current_state == 'success'"/>
                                    <field name="current_score" readonly="1" force_save="1" />
                                     -->
                                </list>
                            </field>
                        </page>
                        <page string="Members">
                            <field name="member_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_action" model="ir.actions.act_window">
        <field name="name">KPI Definations</field>
        <field name="res_model">kpi.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create record..
            </p>
        </field>
    </record>

    <!-- <menuitem
        id="menu_root_kpi"
        name="KPI"
        action="kpi_action" /> -->

    <menuitem
        id="menu_kpi_kpi"
        name="KPI"
        parent="menu_root_kpi"
        action="kpi_action"
        sequence="20"/>


</odoo>
