<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_kpi_list" model="ir.ui.view">
        <field name="name">kpi.kpi.list</field>
        <field name="model">kpi.kpi</field>
        <field name="arch" type="xml">
        <list>
            <field name="name" />
            <field name="team_id" />
            <field name="from_date" />
            <field name="to_date" />
        </list>
        </field>
    </record>

    <record id="view_kpi_form" model="ir.ui.view">
        <field name="name">kpi.kpi.form</field>
        <field name="model">kpi.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="team_id" />
                        <field name="from_date" />
                        <field name="to_date" />
                    </group>

                    <notebook>
                        <page string="Targets">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="parameter_id"/>
                                    <field name="allocation"/>
                                    <field name="value"/>
                                    <field name="score" readonly="1" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employee Targets">
                            <field name="employee_target_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="kpi_line_id" force_save="1"  optional="hide"/>
                                    <field name="employee_id" readonly="1" force_save="1"/>
                                    <field name="parameter_id" readonly="1" force_save="1"/>
                                    <field name="value" force_save="1"/>
                                    
                                </list>
                            </field>
                        </page>
                        <page string="Members">
                            <field name="member_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kpi_action" model="ir.actions.act_window">
        <field name="name">KPI</field>
        <field name="res_model">kpi.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create record..
            </p>
        </field>
    </record>

    <menuitem
        id="menu_root_kpi"
        name="KPI"
        action="kpi_action" />

    <menuitem
        id="menu_kpi_kpi"
        name="KPI"
        parent="menu_root_kpi"
        action="kpi_action"
        sequence="10"/>


</odoo>
